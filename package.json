{
  "name": "pbz-mod-manager",
  "version": "1.1.0",
  "description": "Mod manager for Phantom Blade Zero with a Nexus Mods store",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/library.test.cjs",
    "package:win": "electron-packager . \"PBZ Mod Manager\" --platform=win32 --arch=x64 --out=release --overwrite --asar.unpackDir=\"**/node_modules/7zip-bin/**\" --ignore=\"^/(release|test|\\.vscode)\" --icon=assets/icon.ico",
    "package:mac": "electron-packager . \"PBZ Mod Manager\" --platform=darwin --arch=arm64 --out=release --overwrite --asar.unpackDir=\"**/node_modules/7zip-bin/**\" --ignore=\"^/(release|test|\\.vscode)\" --protocol=nxm --protocol-name=\"Nexus Mods\""
  },
  "author": "PBZ Mod Manager",
  "license": "MIT",
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "electron": "^45.3.2"
  },
  "productName": "PBZ Mod Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/gxzedtv/pbz-mod-manager.git"
  }
}